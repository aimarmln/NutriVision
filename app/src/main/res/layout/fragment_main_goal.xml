<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/activity_horizontal_margin">

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/hanken_grotesk_bold"
        android:text="@string/main_goal_form_question"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMainGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestion"
        app:layout_constraintVertical_bias="0.0"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLoseWeight"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:checked="true"
            android:fontFamily="@font/hanken_grotesk_bold"
            android:text="@string/main_goal_lose_weight"
            android:textSize="20sp"
            app:chipStartPadding="60dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMaintainWeight"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:fontFamily="@font/hanken_grotesk_bold"
            android:text="@string/main_goal_maintain_weight"
            android:textSize="20sp"
            app:chipStartPadding="60dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGainWeight"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:fontFamily="@font/hanken_grotesk_bold"
            android:text="@string/main_goal_gain_weight"
            android:textSize="20sp"
            app:chipStartPadding="60dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:clickable="false"
            android:fontFamily="@font/hanken_grotesk_bold"
            android:text="@string/main_goal_gain_weight"
            android:textSize="20sp"
            android:visibility="invisible"
            app:chipStartPadding="60dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:clickable="false"
            android:fontFamily="@font/hanken_grotesk_bold"
            android:text="@string/main_goal_gain_weight"
            android:textSize="20sp"
            android:visibility="invisible"
            app:chipStartPadding="60dp" />

    </com.google.android.material.chip.ChipGroup>

</androidx.constraintlayout.widget.ConstraintLayout>